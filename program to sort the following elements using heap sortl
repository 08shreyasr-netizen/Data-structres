#include<stdio.h>
#include<conio.h>
void heapify (int arr[],int n, int i)
{
int large=i;
int left = 2*i+1;
int right=2*i+2;
int temp;
if(left<n && arr[left]>arr[large])
large=left;
if(right<n && arr[right]>arr[large])
large=right;
if(large!=i)
{
temp=arr[i];
arr[i]=arr[large];
arr[large]=temp;
heapify(arr,n,large);
}
}
void heapsort(int arr[],int n)
{
int i,temp;
for(i=n/2-1;i>=0;i--)
heapify(arr,n,i);
for(i=n-1;i>=0;i--)
{
temp=arr[0];
arr[0]=arr[i];
arr[i]=temp;
heapify(arr,i,0);
}
}
